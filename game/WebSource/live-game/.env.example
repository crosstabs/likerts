# Non-secret template only; the executable does not auto-load this file.
# Production remains gated on approved hosting, database, routing and privacy setup.
NODE_ENV=production
LIKERTS_LIVE_BIND_ADDRESS=0.0.0.0
LIKERTS_LIVE_PORT=4311
# Replace both origins with the approved dedicated game-service HTTPS origin.
# This example is not a provisioned domain and does not alter the marketing site.
LIKERTS_LIVE_PUBLIC_ORIGIN=https://live.example.invalid
LIKERTS_LIVE_ORIGINS=https://live.example.invalid
# Supply the dedicated game database via the approved environment, never survey DATABASE_URL.
LIKERTS_LIVE_DATABASE_URL=

# Friends-first launch ceilings, not measured production-capacity guarantees.
# Production MAX_ROOMS:1..4; MAX_PLAYERS is fixed12; socket caps may only be reduced.
LIKERTS_LIVE_MAX_ROOMS=4
LIKERTS_LIVE_MAX_PLAYERS=12
LIKERTS_LIVE_MAX_SOCKETS=64
# Two leases for each of twelve players plus the dedicated host during reconnect grace.
LIKERTS_LIVE_MAX_SOCKETS_PER_ROOM=26
LIKERTS_LIVE_MAX_SOCKETS_PER_MEMBER=2
LIKERTS_LIVE_MAX_BODY_BYTES=8192
LIKERTS_LIVE_MAX_FRAME_BYTES=4096
LIKERTS_LIVE_MAX_BUFFERED_BYTES=262144
LIKERTS_LIVE_MAX_REQUESTS=50000
LIKERTS_LIVE_AUTH_TIMEOUT_MS=5000
LIKERTS_LIVE_CREATE_PER_MINUTE=12
LIKERTS_LIVE_JOIN_PER_MINUTE=120
LIKERTS_LIVE_ACTIONS_PER_MINUTE=3000
LIKERTS_LIVE_CONNECTIONS_PER_MINUTE=120
LIKERTS_LIVE_FRAMES_PER_MINUTE=120
LIKERTS_LIVE_REFRESH_PER_MINUTE=60
# Health is cached and uses only a local request budget, never a DB budget per request.
LIKERTS_LIVE_HEALTH_PER_MINUTE=120
LIKERTS_LIVE_READINESS_INTERVAL_MS=5000
LIKERTS_LIVE_READINESS_MAX_AGE_MS=15000

# For local development instead: NODE_ENV=development, loopback binding,
# and an explicit private on-disk LIKERTS_LIVE_SQLITE_PATH outside the checkout.
