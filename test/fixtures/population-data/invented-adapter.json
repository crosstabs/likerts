{
  "adapterVersion": "population-source-adapter-v1",
  "id": "invented-age-adapter",
  "format": "CSV",
  "expectedColumns": ["AGE_GROUP", "RESIDENCE_STATUS", "COUNT"],
  "filters": [
    { "field": "RESIDENCE_STATUS", "operator": "EQUALS", "value": "usual" }
  ],
  "recodes": [
    {
      "variableId": "age",
      "label": "Age group",
      "sourceField": "AGE_GROUP",
      "categories": [
        { "code": "18-34", "label": "18 to 34", "sourceValues": ["18-24", "25-34"] },
        { "code": "35+", "label": "35 or older", "sourceValues": ["35-54", "55+"] }
      ]
    }
  ],
  "countField": "COUNT",
  "denominator": {
    "method": "SUM_INCLUDED_COUNTS",
    "label": "Usual resident adults",
    "unit": "PERSONS"
  },
  "exclusions": ["Temporary residents are excluded by the declared residence-status filter."],
  "rounding": { "method": "HALF_UP_WITH_FINAL_BALANCE", "decimalPlaces": 8 }
}
