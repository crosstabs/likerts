{
  "name": "@likerts/react-native",
  "version": "0.0.3",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": ">=0.85 <0.88"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./offline": {
      "types": "./lib/offline.d.ts",
      "react-native": "./src/offline.ts",
      "default": "./lib/offline.js"
    }
  },
  "description": "In-product survey collection for React Native with Likerts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crosstabs/likerts.git",
    "directory": "sdks/react-native"
  },
  "homepage": "https://likerts.com/docs",
  "bugs": {
    "url": "https://github.com/crosstabs/likerts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "likerts",
    "surveys",
    "feedback",
    "react-native"
  ]
}
