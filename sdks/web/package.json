{
  "name": "@likerts/web",
  "version": "0.0.3",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./offline": {
      "types": "./dist/offline.d.ts",
      "import": "./dist/offline.js",
      "default": "./dist/offline.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.19",
    "jsdom": "26.1.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "description": "In-product survey collection for web applications with Likerts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crosstabs/likerts.git",
    "directory": "sdks/web"
  },
  "homepage": "https://likerts.com/docs",
  "bugs": {
    "url": "https://github.com/crosstabs/likerts/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "likerts",
    "surveys",
    "feedback",
    "web"
  ]
