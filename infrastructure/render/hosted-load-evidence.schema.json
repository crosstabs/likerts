{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time"
    },
    "base": {
      "type": "string",
      "pattern": "^https://[^/?#]+$"
    },
    "temporaryWorkspace": {
      "type": "string",
      "pattern": "^hosted-launch-[a-z0-9-]+$"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pacedResponses": {
          "const": 100
        },
        "pacedRequestsPerSecond": {
          "const": 5
        },
        "burstResponses": {
          "const": 100
        },
        "maximumConcurrency": {
          "const": 10
        },
        "duplicateRequests": {
          "const": 20
        },
        "invalidRequests": {
          "const": 10
        },
        "unauthorizedRequests": {
          "const": 10
        },
        "capRaceRequests": {
          "const": 20
        },
        "capRaceAcceptances": {
          "const": 10
        },
        "expectedAcceptedResponses": {
          "const": 211
        },
        "maximumSubmissionRequests": {
          "const": 260
        }
      },
      "required": [
        "pacedResponses",
        "pacedRequestsPerSecond",
        "burstResponses",
        "maximumConcurrency",
        "duplicateRequests",
        "invalidRequests",
        "unauthorizedRequests",
        "capRaceRequests",
        "capRaceAcceptances",
        "expectedAcceptedResponses",
        "maximumSubmissionRequests"
      ]
    },
    "phases": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "paced-valid",
              "burst-valid",
              "duplicate-retries",
              "invalid-answers",
              "unauthorized",
              "cap-race"
            ]
          },
          "requests": {
            "type": "integer",
            "minimum": 0
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "targetRequestsPerSecond": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "seconds": {
            "type": "number",
            "minimum": 0
          },
          "requestsPerSecond": {
            "type": "number",
            "minimum": 0
          },
          "statuses": {
            "type": "object",
            "propertyNames": {
              "pattern": "^([1-5][0-9]{2}|transport_error|oversized)$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "latencyMs": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "p50": {
                "type": "number",
                "minimum": 0
              },
              "p95": {
                "type": "number",
                "minimum": 0
              },
              "p99": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "p50",
              "p95",
              "p99"
            ]
          },
          "scheduledLatencyP95Ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "name",
          "requests",
          "concurrency",
          "targetRequestsPerSecond",
          "seconds",
          "requestsPerSecond",
          "statuses",
          "latencyMs",
          "scheduledLatencyP95Ms"
        ]
      }
    },
    "accounting": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uniqueAcceptedReceipts": {
              "type": "integer",
              "minimum": 0
            },
            "acceptedResponses": {
              "type": "integer",
              "minimum": 0
            },
            "chargedCents": {
              "type": "integer",
              "minimum": 0
            },
            "promotionalResponses": {
              "type": "integer",
              "minimum": 0
            },
            "promotionalCreditsRemaining": {
              "type": "integer",
              "minimum": 0
            },
            "paidCredits": {
              "type": "integer",
              "minimum": 0
            },
            "paidCreditDebt": {
              "type": "integer",
              "minimum": 0
            },
            "paidResponses": {
              "type": "integer",
              "minimum": 0
            },
            "unpaidExposureCents": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "uniqueAcceptedReceipts",
            "acceptedResponses",
            "chargedCents",
            "promotionalResponses",
            "promotionalCreditsRemaining",
            "paidCredits",
            "paidCreditDebt",
            "paidResponses",
            "unpaidExposureCents"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z_]+$"
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workspaceTombstoned": {
          "type": "boolean"
        },
        "bootstrapDenied": {
          "type": "boolean"
        },
        "childDenied": {
          "type": "boolean"
        }
      },
      "required": [
        "workspaceTombstoned",
        "bootstrapDenied",
        "childDenied"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "measuredAt",
    "base",
    "temporaryWorkspace",
    "status",
    "workload",
    "phases",
    "accounting",
    "failures",
    "cleanup",
    "limitations"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://likerts.com/schemas/hosted-load-evidence-v1.json",
  "title": "Bounded hosted load acceptance evidence",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "failures": {
            "maxItems": 0
          },
          "phases": {
            "minItems": 6
          },
          "cleanup": {
            "properties": {
              "workspaceTombstoned": {
                "const": true
              },
              "bootstrapDenied": {
                "const": true
              },
              "childDenied": {
                "const": true
              }
            }
          },
          "accounting": {
            "type": "object",
            "properties": {
              "uniqueAcceptedReceipts": {
                "const": 211
              },
              "acceptedResponses": {
                "const": 211
              },
              "chargedCents": {
                "const": 211
              },
              "promotionalResponses": {
                "const": 211
              },
              "promotionalCreditsRemaining": {
                "const": 789
              },
              "paidCredits": {
                "const": 0
              },
              "paidCreditDebt": {
                "const": 0
              },
              "paidResponses": {
                "const": 0
              },
              "unpaidExposureCents": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ]
}
