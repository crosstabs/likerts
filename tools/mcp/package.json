{
  "name": "@likerts/mcp",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/package-data.mjs",
    "test": "tsx --test test/*.test.ts",
