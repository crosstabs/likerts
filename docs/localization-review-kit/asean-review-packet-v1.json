    {"id": "survey-methods", "capability": "instrument", "title": "All survey-method templates", "steps": ["Concept testing", "Message testing", "Claims testing", "Purchase-intent testing", "Price sensitivity", "Feature prioritization", "Brand positioning", "UX expectation testing", "Survey pretesting", "Interview-guide generation"], "check": ["method constructs remain distinct", "inputs and validation are natural", "scale anchors retain polarity and spacing", "real-person handoff is explicit"]},
    {"id": "respondent-instrument", "capability": "instrument", "title": "Respondent instrument and handoff", "steps": ["Open questionnaire preview", "Read consent/privacy/accessibility copy", "Inspect question wording and anchors", "Inspect translation-review blocker", "Export questionnaire specification"], "check": ["no generated answer is a participant quotation", "placeholders survive export", "screen-reader names are meaningful", "unsupported locale cannot run"]},
    {"id": "results", "capability": "report", "title": "Results, disclosures, and formatting", "steps": ["Read primary outcome", "Read model-generated perspective disclosure", "Read method interpretation", "Inspect dates/currency/percentages", "Inspect stability caveat"], "check": ["no fictional sample size or confidence interval", "demographic fit is not attitudinal accuracy", "numbers and dates are locale-aware when enabled", "user copy is not silently translated"]},
    {"id": "population-frame", "capability": "report", "title": "Population frame and evidence boundaries", "steps": ["Read intended population", "Read market and language", "Read margins and coverage date", "Read official datasets and intersections", "Read weighting method", "Read unsupported characteristics", "Read Population Fit disclaimer"], "check": ["conditional audience is not official coverage without evidence", "fit does not imply accuracy", "unknown values remain unknown", "population evidence is separate from language review"]},
    {"id": "evidence", "capability": "source", "title": "Evidence ledger and original language", "steps": ["Open each source", "Inspect publisher/title/URL/date", "Inspect original language", "Inspect excerpt and caveat", "Inspect retrieval hash and timestamp"], "check": ["source text is not ground truth by default", "original-language handling is explicit", "source IDs and hashes are exact", "no silent translation is introduced"]},
    {"id": "retrieval", "capability": "retrieval", "title": "Retrieval policy and geography", "steps": ["Set preferred retrieval language", "Test REQUIRE", "Test PREFER", "Test ANY", "Test no matching source", "Inspect resolved geography"], "check": ["country routing matches market", "Global has no implicit country", "REQUIRE fails closed", "language preference is not validation evidence"]},
    {"id": "script-input-layout", "capability": "ui", "title": "Script, font, input, and line breaks", "steps": ["Enter native-script text", "Paste mixed-script text", "Use locale keyboard/input method", "Resize from 320 to 1440 px", "Inspect headings, controls, charts, and exports"], "check": ["expected script is rendered", "fallback fonts are legible", "IME composition is preserved", "line breaks do not change meaning or clip text"]},
    {"id": "sample-library", "capability": "sample", "title": "Samples, saved projects, and exports", "steps": ["When a review-only sample exists, open it without treating it as runtime support", "Inspect localization receipt", "Save and reopen an enabled-locale control sample", "Export report and questionnaire", "Use registry/API checks—not the live selector—to confirm planned and roadmap locales remain rejected"], "check": ["canonical dimensions persist", "unsupported status persists", "exports keep IDs and review state", "no approval claim appears"]}
  ],
