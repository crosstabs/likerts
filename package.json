{
  "name": "likerts-synthetic-research",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run population:build && npm run studies:build && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "eval:offline": "node scripts/eval-offline.js",
    "eval:fixtures": "node --test tests/eval-scoring.test.js",
    "eval:live": "node scripts/eval-live.js",
    "eval:release": "node scripts/eval-release-gate.mjs",
    "localization:review:intake": "node scripts/import-native-review-evidence.mjs",
    "localization:catalog-hash": "node scripts/print-localization-catalog-hash.mjs",
    "localization:smoke": "node scripts/smoke-localization-deployment.mjs",
    "verify:browser": "node scripts/verify-browser.mjs",
    "attestation:bundle": "node scripts/build-browser-attestation-bundle.mjs",
    "attestation:bundle:verify": "node scripts/build-browser-attestation-bundle.mjs --verify",
    "attestation:promote": "node scripts/promote-browser-attestation.mjs",
    "admission:verify:live": "node scripts/verify-admission-store-integration.mjs",
    "admission:verify:contention": "node scripts/verify-admission-store-contention.mjs",
    "studies:build": "node scripts/build-sample-studies.mjs",
    "studies:capture": "node scripts/capture-sample-studies.mjs",
    "studies:verify": "node scripts/verify-sample-study-content.mjs",
    "studies:verify:browser": "node scripts/verify-study-library-browser.mjs",
    "population:build": "node scripts/build-population-registry.mjs"
