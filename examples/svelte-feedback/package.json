{
  "name": "likerts-svelte-feedback-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "start": "node --env-file-if-exists=.env.local scripts/server.mjs",
    "demo": "node scripts/run-local.mjs",
    "check": "node scripts/run-local.mjs --check"
  },
  "dependencies": {
    "@likerts/web": "0.0.3",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "svelte-check": "4.7.6"
  }
}
